rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'cashier'];
    }

    function isAdminUser() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isManagerUser() {
      return isActiveUser()
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }

    function isValidSaleItem(item) {
      return item is map
        && item.keys().hasAll(['product_id', 'product_name', 'quantity', 'price_cents', 'subtotal', 'unit_cost_cents', 'cost_subtotal_cents', 'cost_source', 'cost_is_estimated', 'category'])
        && item.keys().hasOnly(['product_id', 'product_name', 'quantity', 'price_cents', 'subtotal', 'unit_cost_cents', 'cost_subtotal_cents', 'cost_source', 'cost_is_estimated', 'category'])
        && item.product_id is string
        && item.product_id.size() > 0
        && item.product_name is string
        && item.product_name.size() > 0
        && item.quantity is int
        && item.quantity > 0
        && item.price_cents is int
        && item.price_cents >= 0
        && item.subtotal is int
        && item.subtotal >= 0
        && item.unit_cost_cents is int
        && item.unit_cost_cents >= 0
        && item.cost_subtotal_cents is int
        && item.cost_subtotal_cents >= 0
        && item.cost_source in ['purchase', 'fallback_price']
        && item.cost_is_estimated is bool
        && item.category is string
        && item.category.size() > 0;
    }

    // Rules cannot iterate a list; validate every supported POS line explicitly.
    // Larger carts are rejected rather than bypassing item validation.
    function isValidSaleItems(items) {
      return items is list
        && items.size() > 0
        && items.size() <= 20
        && isValidSaleItem(items[0])
        && (items.size() <= 1 || isValidSaleItem(items[1]))
        && (items.size() <= 2 || isValidSaleItem(items[2]))
        && (items.size() <= 3 || isValidSaleItem(items[3]))
        && (items.size() <= 4 || isValidSaleItem(items[4]))
        && (items.size() <= 5 || isValidSaleItem(items[5]))
        && (items.size() <= 6 || isValidSaleItem(items[6]))
        && (items.size() <= 7 || isValidSaleItem(items[7]))
        && (items.size() <= 8 || isValidSaleItem(items[8]))
        && (items.size() <= 9 || isValidSaleItem(items[9]))
        && (items.size() <= 10 || isValidSaleItem(items[10]))
        && (items.size() <= 11 || isValidSaleItem(items[11]))
        && (items.size() <= 12 || isValidSaleItem(items[12]))
        && (items.size() <= 13 || isValidSaleItem(items[13]))
        && (items.size() <= 14 || isValidSaleItem(items[14]))
        && (items.size() <= 15 || isValidSaleItem(items[15]))
        && (items.size() <= 16 || isValidSaleItem(items[16]))
        && (items.size() <= 17 || isValidSaleItem(items[17]))
        && (items.size() <= 18 || isValidSaleItem(items[18]))
        && (items.size() <= 19 || isValidSaleItem(items[19]));
    }

    function isValidSaleCreate() {
      return request.resource.data.keys().hasAll(['date', 'createdAt', 'schema_version', 'created_by_uid', 'created_by_role', 'total', 'total_cost_cents', 'payment_method', 'items'])
        && request.resource.data.keys().hasOnly(['date', 'createdAt', 'schema_version', 'created_by_uid', 'created_by_role', 'total', 'total_cost_cents', 'payment_method', 'items'])
        && request.resource.data.date is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.schema_version == 2
        && request.resource.data.created_by_uid is string
        && request.resource.data.created_by_uid.size() > 0
        && request.resource.data.created_by_role in ['admin', 'manager', 'cashier']
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.total_cost_cents is int
        && request.resource.data.total_cost_cents >= 0
        && request.resource.data.payment_method is string
        && request.resource.data.payment_method in ['cash', 'card', 'other']
        && isValidSaleItems(request.resource.data.items);
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || isAdminUser());
      allow create, delete: if isAdminUser();
      allow update: if isActiveUser()
        && (isAdminUser()
            && (request.auth.uid != userId
                || request.resource.data.role == resource.data.role)
            || (request.auth.uid == userId
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])));
    }

    // Productos - lectura autenticados, escritura admin/manager
    match /products/{productId} {
      allow read: if isActiveUser();
      allow create: if isManagerUser();
      allow update: if isManagerUser();
      allow delete: if isAdminUser();
    }

    // Ventas - el backend Admin SDK crea ventas tras validar el stock atomico.
    match /sales/{saleId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && false;
      allow update, delete: if false;
    }

    // Roles - solo admins
    match /roles/{roleId} {
      allow read: if isActiveUser();
      allow write: if isAdminUser();
    }

    // Conversaciones de WhatsApp - lectura/escritura admin/manager
    match /whatsapp_conversations/{conversationId} {
      allow read: if isManagerUser();
      allow create, update: if isManagerUser();
      allow delete: if isAdminUser();
    }

    // Mensajes de WhatsApp - lectura/escritura admin/manager
    match /whatsapp_messages/{messageId} {
      allow read: if isManagerUser();
      allow create: if isManagerUser();
      allow update, delete: if isAdminUser();
    }

    // Órdenes de WhatsApp - lectura/escritura admin/manager
    match /whatsapp_orders/{orderId} {
      allow read: if isManagerUser();
      allow create, update: if isManagerUser();
      allow delete: if isAdminUser();
    }

    // Proveedores - lectura admin/manager, escritura admin/manager
    match /suppliers/{supplierId} {
      allow read: if isManagerUser();
      allow create, update: if isManagerUser();
      allow delete: if isAdminUser();
    }

    // Órdenes de compra - lectura admin/manager, escritura admin/manager (cajeros no gestionan ordenes)
    match /purchase_orders/{orderId} {
      allow read: if isManagerUser();
      allow create, update: if isManagerUser();
      allow delete: if isAdminUser();
    }
  }
}
