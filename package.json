{
  "name": "surtifacil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "seed:roles": "node scripts/seedRoles.js",
    "seed:products": "node scripts/seedProducts.js",
    "seed:all": "npm run seed:roles && npm run seed:products",
    "start:web": "cd web && npm run dev",
    "start:backend": "node backend/whatsapp-webhook.js",
    "dev:all": "concurrently \"npm run start:web\" \"npm run start:backend\"",
    "whatsapp:init": "node scripts/whatsapp-init.js",
    "build:web": "cd web && npm run build",
    "test": "cd web && npm run test",
    "deploy": "npm run build:web && firebase deploy --only hosting",
    "deploy:hosting": "npm run build:web && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:all": "npm run build:web && firebase deploy",
    "docs": "echo 'See docs/run_instructions.md'"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
